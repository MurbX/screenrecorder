#include <windows.h>
#include "version.h"

1 RT_MANIFEST "app.manifest"
101 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SCREENREC_VERSION_MAJOR, SCREENREC_VERSION_MINOR, SCREENREC_VERSION_PATCH, 0
PRODUCTVERSION SCREENREC_VERSION_MAJOR, SCREENREC_VERSION_MINOR, SCREENREC_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ScreenRec contributors"
            VALUE "FileDescription", "ScreenRec screen recorder"
            VALUE "InternalName", "ScreenRec"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "ScreenRec.exe"
            VALUE "ProductName", "ScreenRec"
            VALUE "FileVersion", SCREENREC_VERSION_A
            VALUE "ProductVersion", SCREENREC_VERSION_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
